cmake_minimum_required(VERSION 3.20)
set(expected_exit 2)
if(CASE STREQUAL "exe_help")
    set(arguments exe --help)
    set(expected_exit 0)
elseif(CASE STREQUAL "exe_missing")
    set(arguments exe)
elseif(CASE STREQUAL "exe_unknown")
    set(arguments exe verify sample.exe)
elseif(CASE STREQUAL "exe_check_out_rejected")
    set(arguments exe check sample.exe --out a)
elseif(CASE STREQUAL "exe_patch_extra_input")
    set(arguments exe patch a.exe b.exe)
elseif(CASE STREQUAL "exe_check_missing_file")
    set(arguments exe check __no_such_file__.exe)
    set(expected_exit 1)
elseif(CASE STREQUAL "exe_patch_missing_file")
    set(arguments exe patch __no_such_file__.exe)
    set(expected_exit 1)
elseif(CASE STREQUAL "exe_local")
    # 仅当显式启用本地样本（EAGLS_LOCAL_CONTENT_DIR）时注册；
    # 对真实 EAGLS.exe 打补丁并要求产物 SHA-256 与已验证版本一致。
    set(arguments exe patch "${SAMPLE}" --out "${OUTPUT}" --overwrite)
    set(expected_exit 0)
    set(expected_hash "c86cceb5fdd195cad415fa22c98d5018c8935dcc6c0257d16e0f9c538e1ef4b6")
else()
    message(FATAL_ERROR "未知 exe 命令测试：${CASE}")
endif()
execute_process(COMMAND "${CLI}" ${arguments}
    RESULT_VARIABLE actual_exit OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 30)
if(NOT "${actual_exit}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "退出码不符：预期 ${expected_exit}，实际 ${actual_exit}；${output}；${error}")
endif()
if(expected_exit EQUAL 0)
    if(NOT error STREQUAL "")
        message(FATAL_ERROR "成功执行时不应写入标准错误：${error}")
    endif()
    if(CASE STREQUAL "exe_help")
        if(NOT output MATCHES "用法：eagls")
            message(FATAL_ERROR "exe 帮助输出不符。")
        endif()
    elseif(CASE STREQUAL "exe_local")
        if(NOT output MATCHES "已写出")
            message(FATAL_ERROR "补丁命令未报告写出结果：${output}")
        endif()
        file(SHA256 "${OUTPUT}" actual_hash)
        if(NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "补丁产物 SHA-256 不符：${actual_hash}")
        endif()
    endif()
elseif(expected_exit EQUAL 1)
    if(NOT output STREQUAL "" OR error STREQUAL "")
        message(FATAL_ERROR "运行期错误必须只向标准错误输出信息。")
    endif()
else()
    if(NOT output STREQUAL "" OR NOT error MATCHES "--help")
        message(FATAL_ERROR "非法参数必须只向标准错误输出帮助提示。")
    endif()
endif()
