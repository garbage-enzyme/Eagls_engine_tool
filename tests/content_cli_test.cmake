cmake_minimum_required(VERSION 3.20)
set(expected_exit 2)
if(CASE STREQUAL "dat_help")
    set(arguments dat --help)
    set(expected_exit 0)
elseif(CASE STREQUAL "gr_help")
    set(arguments gr --help)
    set(expected_exit 0)
elseif(CASE STREQUAL "dat_missing")
    set(arguments dat)
elseif(CASE STREQUAL "gr_missing")
    set(arguments gr decode)
elseif(CASE STREQUAL "missing_out")
    set(arguments dat text sample.dat)
elseif(CASE STREQUAL "duplicate_out")
    set(arguments dat text sample.dat --out a --out b)
elseif(CASE STREQUAL "unknown_option")
    set(arguments gr decode sample.gr --out a --unknown)
elseif(CASE STREQUAL "missing_value")
    set(arguments gr decode sample.gr --out --overwrite)
elseif(CASE STREQUAL "extra_input")
    set(arguments dat decrypt a.dat b.dat --out a)
elseif(CASE STREQUAL "unsupported_action")
    set(arguments gr encode sample.bmp --out a)
else()
    message(FATAL_ERROR "未知内容命令测试：${CASE}")
endif()
execute_process(COMMAND "${CLI}" ${arguments}
    RESULT_VARIABLE actual_exit OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8 TIMEOUT 5)
if(NOT "${actual_exit}" STREQUAL "${expected_exit}")
    message(FATAL_ERROR "退出码不符：${actual_exit}；${output}；${error}")
endif()
if(expected_exit EQUAL 0)
    if(NOT error STREQUAL "" OR NOT output MATCHES "用法：eagls")
        message(FATAL_ERROR "内容帮助输出不符。")
    endif()
elseif(NOT output STREQUAL "" OR NOT error MATCHES "--help")
    message(FATAL_ERROR "非法参数必须只向标准错误输出帮助提示。")
endif()
